# Copy to .env.local and fill in. Never commit that file.

# Canonical origin, used for metadata on /privacy, /terms, and /support.
NEXT_PUBLIC_SITE_URL=https://acornsnest.com

WALKTHROUGH_TO_EMAIL=you@yourdomain.com
# Inbox for the /support form. Falls back to WALKTHROUGH_TO_EMAIL when unset.
SUPPORT_TO_EMAIL=support@yourdomain.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Acorns Nest Support <support@acornsnest.com>

# Server-only. /accept-invite verifies the Supabase invite code with these.
# Use the same project as the backend. Never put the service role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
