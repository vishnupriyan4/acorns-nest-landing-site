# Copy to .env.local and fill in. Never commit that file.

# Inbox that should receive walkthrough requests
WALKTHROUGH_TO_EMAIL=you@example.com

# https://resend.com/api-keys — free tier is enough
RESEND_API_KEY=re_xxxxxxxx

# Optional. Until you verify a domain, Resend's onboarding address
# can only deliver to the email on your Resend account.
# RESEND_FROM_EMAIL=Acorns Nest <hello@yourdomain.com>
