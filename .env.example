# Copy to .env.local and fill in. Never commit that file.

# Canonical origin, used for metadata on /privacy, /terms, and /support.
NEXT_PUBLIC_SITE_URL=https://acornsnest.com

WALKTHROUGH_TO_EMAIL=you@yourdomain.com
# Inbox for the /support form. Falls back to WALKTHROUGH_TO_EMAIL when unset.
SUPPORT_TO_EMAIL=support@yourdomain.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Acorns Nest Support <support@acornsnest.com>

# Backend that accepts the invite code. This site does not call Supabase.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Cookie banner and GA4 stay off until BOTH of these are set.
# Leave them unset in production until Privacy Policy v2 is published.
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional. Sends hits to GA4 DebugView. Leave unset in production.
# NEXT_PUBLIC_GA_DEBUG=true
